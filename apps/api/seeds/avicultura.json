    "rateTerms": [
      "eclosao",
      "eclo",
      "fertilidade",
      "infertilidade",
      "fertil",
      "infertil",
      "viab",
      "viabilidade",
      "postura",
      "contamin",
      "mort"
    ],
    "ratePhrases": ["ovo_ave", "ovo_inc_ave", "pinto_ave"],
    "consumptionTerms": ["racao"],
    "gramTerms": ["proteina", "lisina", "metionina", "cistina"],
    "kcalTerms": ["calor"],
    "countPrefixes": ["classif", "ovos"],
    "countNouns": ["ovos", "ovo", "pintos", "pinto", "bandejas", "aves"],
    "dimensionTerms": [
      "granja",
      "linhagem",
      "nucleo",
      "galpao",
      "galinheiro",
      "box",
      "incubatorio",
      "especie",
      "espec",
      "ave",
      "est",
      "maq",
      "incubacao",
      "estocagem"
    ],
    "keyNames": [
      "cod_lote_num",
      "chave_0",
      "codigo_lote",
      "codigo_lote_completo",
      "codigo_lote_f",
      "codigo_lote_m",
      "lote",
      "nro_lote",
      "cod_lf",
      "cod_lm"
    ],
    "sourceRules": [
      { "term": "mort", "label": "mort", "match": "token" },
      { "term": "ovosc", "label": "ovosc", "match": "token" },
      { "term": "auditoria", "label": "auditoria", "match": "token" },
      { "term": "transf", "label": "transferencia", "match": "token" },
      { "term": "gra", "label": "granja", "match": "suffix" },
      { "term": "inc", "label": "incubatorio", "match": "suffix" }
    ],
    "overlappingBuckets": {
      "00a07": ["00a03", "04a07"],
      "15a21": ["15a18", "19a21"]
    },
    "notes": [
      "idade = semana de vida do lote (nunca ano, nunca data, nunca idade de pessoa)",
      "_padrao e a meta da linhagem, nunca o resultado obtido",
      "faixas de mortalidade embrionaria se contem: 00a07 = 00a03 + 04a07, 15a21 = 15a18 + 19a21"
    ]
  },
  "tableFacts": {
    "ubi.avfsDesempenho_Producao": {
      "grain": "1 linha = lote x semana de idade (fase de producao)",
      "eventDateColumn": "data"
    },
    "ubi.avfsDesempenho_Recria": {
      "grain": "1 linha = lote x semana de idade (fase de recria)",
      "eventDateColumn": "data"
    },
    "ubi.avfsPesagem_Recria": {
      "grain": "1 linha = lote x semana de idade x sexo x box"
    },
    "ubi.avfsAproveitamento_OvoGranja_Inccubatorio": {
      "grain": "1 linha = lote x dia de producao"
    },
    "ubi.avfsNutrientes_Racao": {
      "grain": "1 linha = lote x semana de idade",
      "periodJoinTable": "ubi.avfsDesempenho_Producao"
    },
    "ubi.avfsConsumo_Racao_Semana": {
      "grain": "1 linha = lote x semana de idade",
