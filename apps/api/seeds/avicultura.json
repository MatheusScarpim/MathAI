      "grain": "1 linha = lote (resumo do lote inteiro)",
      "eventDateColumn": null,
      "periodJoinTable": "ubi.cifsResumo_Nascimento",
      "periodJoinColumns": ["cod_lote_num"]
    },
    "ubi.cifsResumo_Nascimento": {
      "grain": "1 linha = lote x incubacao x maquina",
      "eventDateColumn": "dat_retirada"
    },
    "ubi.cifsPerdas_Transferencia": {
      "grain": "1 linha = lote x incubacao",
      "eventDateColumn": "dat_transferencia"
    },
    "ubi.cifsPerdaPesoIncub": {
      "grain": "1 linha = lote x incubacao x maquina",
      "eventDateColumn": "dat_incub"
    },
    "ubi.cifsOvos_Incubadora": {
      "grain": "1 linha = lote x incubacao",
      "eventDateColumn": "dat_incub"
    },
    "ubi.cifsSaldo_Ovos_Incubaveis": {
      "grain": "1 linha = saldo pontual de ovos incubaveis"
    },
    "ubi.cifsSaldo_Ovos_Classificar": {
      "grain": "1 linha = saldo pontual de ovos a classificar",
      "eventDateColumn": "dat_rec"
    }
  },
