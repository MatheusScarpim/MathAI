{
  "name": "@auraia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "tsc -p ../../packages/shared/tsconfig.json",
    "predev": "npm run build:shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build:shared",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretest": "npm run build:shared",
    "test": "tsx --test \"src/**/*.test.ts\" \"eval/**/*.test.ts\"",
    "eval": "tsx eval/run.ts",
    "eval:diff": "tsx eval/diff.ts",
    "eval:bootstrap": "tsx eval/bootstrap.ts",
    "eval:typecheck": "tsc -p eval/tsconfig.json",
    "backfill:history": "tsx src/backfill-history.ts"
  },
  "dependencies": {
    "@auraia/shared": "file:../../packages/shared",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@qdrant/js-client-rest": "^1.9.0",
    "@types/pg": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "js-yaml": "^4.1.1",
    "mongodb": "^6.9.0",
    "mssql": "^10.0.2",
    "mysql2": "^3.17.1",
    "openai": "^4.68.4",
    "oracledb": "^6.7.0",
    "pg": "^8.20.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mssql": "^9.1.7",
    "@types/node": "^20.16.5",
    "@types/oracledb": "^6.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
