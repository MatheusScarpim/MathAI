{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The base config roots at src/ so the build emits a flat dist/. This
    // project only typechecks, so it can root one level up and see both trees.
    "rootDir": ".."
  },
  "include": ["**/*.ts", "../src/**/*.ts"],
  "exclude": ["runs"]
}
