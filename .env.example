# =========================
# MathAI - API / Infra env
# =========================

# API
PORT=3001
LOG_PROMPTS=0

# ── OBRIGATORIOS (API nao sobe sem estes) ──────────────────────────

# Secret para assinar tokens JWT (min 32 chars recomendado)
JWT_SECRET=

# Encrypts sensitive app config stored in Mongo (OpenAI key + DB password)
CONFIG_SECRET=

# Salt para derivacao da chave de criptografia (opcional, default: auraia-salt)
# CONFIG_SALT=

# ── Seguranca ──────────────────────────────────────────────────────

# CORS: origins permitidas (separar por virgula). Use * apenas em dev.
CORS_ORIGIN=*

# Maximo de linhas salvas no historico por query (default 20)
HISTORY_MAX_ROWS=20

# JWT expiration (default 7d)
JWT_EXPIRES_IN=7d

# Infra connections (defaults for docker-compose services below)
QDRANT_URL=http://qdrant:6333
MONGO_URL=mongodb://mongo:27017
MONGO_DB=mathai
REDIS_URL=redis://redis:6379
REDIS_TTL_SECONDS=900

# Oracle driver mode:
# - thin (default): no native client, may fail with NJS-533 when Oracle enforces NNE
# - thick: requires Oracle Instant Client
ORACLE_DRIVER_MODE=thin
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_23_5

# Exposed host ports (docker-compose)
FRONTEND_PORT=80
API_PORT=3001
MONGO_PORT=27017
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Docker Hub images (optional override)
# Example:
# DOCKERHUB_USER=youruser
# MATHAI_TAG=latest
# MATHAI_API_IMAGE=${DOCKERHUB_USER}/mathai-api:${MATHAI_TAG}
# MATHAI_FRONTEND_IMAGE=${DOCKERHUB_USER}/mathai-frontend:${MATHAI_TAG}
DOCKERHUB_USER=
MATHAI_TAG=latest
MATHAI_API_IMAGE=mathai-api:latest
MATHAI_FRONTEND_IMAGE=mathai-frontend:latest

# ── Task Orchestrator ────────────────────────────────────────────────

# Trello
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_DEFAULT_BOARD_ID=
# Secret opcional para verificar webhooks do Trello (header X-Webhook-Secret)
# TRELLO_WEBHOOK_SECRET=

# GitHub
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# Workspaces (diretorio para repos clonados)
WORKSPACE_DIR=/data/auraia-workspaces
WORKSPACE_CMD_TIMEOUT_MS=300000

# ─── Queue de concorrencia (#7 plan W3) ───
# Cap global de tasks rodando em paralelo (sem distincao por provider).
MAX_CONCURRENT_TASKS=3
# G2 — caps por-provider. Quando o planner determina o provider, o slot
# entra nesse counter. Defaults conservadores baseados em rate-limits.
MAX_CONCURRENT_ANTHROPIC=2
MAX_CONCURRENT_DEEPSEEK=3
MAX_CONCURRENT_CODEX=1

# ─── Plan approval gate (#10 plan W2 + G9) ───
# Threshold em USD para forcar aprovacao manual quando custo estimado
# (subtaskCount × avg do provider em task_executions) ultrapassa.
PLAN_APPROVAL_COST_THRESHOLD_USD=0.5

# ─── Trello webhook auto-setup (G5) ───
# URL publica do API onde Trello vai postar eventos (precisa ser HTTPS
# acessivel da internet). Sem esta variavel, webhook NAO eh auto-criado.
# PUBLIC_API_URL=https://api.example.com

# OpenClaude (Code Agent via gRPC) — single legacy container
OPENCLAUDE_GRPC_URL=openclaude:50051
OPENCLAUDE_MODEL=
OPENCLAUDE_PROVIDER=openai
OPENCLAUDE_GRPC_PORT=50051
OPENCLAUDE_BRANCH=main

# ─── Multi-provider fleet (router escolhe um destes por subtask) ───
# Cada container persiste credenciais OAuth no volume openclaude_<provider>_home
# (one-time setup: docker exec -it mathai-openclaude-<provider> bun run cli → /provider → /login).
# Veja docs/openclaude-oauth-setup.md.
OPENCLAUDE_GRPC_URL_ANTHROPIC=openclaude-anthropic:50051
OPENCLAUDE_GRPC_URL_CODEX=openclaude-codex:50051
OPENCLAUDE_GRPC_URL_DEEPSEEK=openclaude-deepseek:50051
OPENCLAUDE_ANTHROPIC_PORT=50052
OPENCLAUDE_CODEX_PORT=50053
OPENCLAUDE_DEEPSEEK_PORT=50054
OPENCLAUDE_MODEL_DEEPSEEK=deepseek-chat

# API keys para planner/reviewer/reporter (NÃO usam OAuth — vão direto via SDK).
# Estes são opcionais: se o router roteia uma chamada não-código pra "anthropic" ou "codex",
# precisa da API key correspondente; senão a chamada falha com erro claro.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_BASE_URL_DEEPSEEK=https://api.deepseek.com
# OPENAI_BASE_URL_ANTHROPIC=https://api.anthropic.com/v1/
# OPENAI_BASE_URL_CODEX=

# Provider do OpenClaude (configura qual LLM o openclaude usa)
# Descomente o provider desejado:

# ── DeepSeek (recomendado) ──
CLAUDE_CODE_USE_OPENAI=1
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-sua-chave-deepseek
OPENCLAUDE_MODEL=deepseek-chat

# ── OpenAI ──
# CLAUDE_CODE_USE_OPENAI=1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-sua-chave-openai
# OPENCLAUDE_MODEL=gpt-4o

# ── Ollama (local) ──
# CLAUDE_CODE_USE_OPENAI=1
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama
# OPENCLAUDE_MODEL=llama3

# ── Gemini ──
# Configure credenciais GCP

# ── GitHub Models ──
# Use /onboard-github no openclaude
